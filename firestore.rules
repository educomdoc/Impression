rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Connection test document
    match /test/connection {
      allow read: if true;
    }

    // Sayuwon Impressions Collection
    match /sayuwon_impressions/{impressionId} {
      // Anyone can read public impressions on the wall
      allow read: if true;

      // Allow creating new impressions with valid fields
      allow create: if request.resource.data.title is string
                    && request.resource.data.title.size() <= 100
                    && request.resource.data.content is string
                    && request.resource.data.content.size() <= 5000;

      // Allow updates to likesCount and comments
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasAny(['likesCount', 'comments']);

      // Allow delete
      allow delete: if true;
    }
  }
}
